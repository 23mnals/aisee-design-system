{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "AiseeTrackingEye.tsx",
              "aisee-agent-test/app/(pages)/engage/**",
              "aisee-agent-test/app/(pages)/engage/_components/**",
              "aisee-agent-test/app/(pages)/engage/_lib/**",
              "animated/**",
              "components/IntentTag/**",
              "components/PlanCard/**",
              "components/StatusBadge/**",
              "design-canvas.jsx",
              "engage-aisee-v2/**",
              "engage-aisee/**",
              "engage-dashboard-redesigned.jsx",
              "engage-replies-page.jsx",
              "engage-replies-tracking.jsx",
              "engage-tracking.jsx",
              "engage-v3/**",
              "engage/**",
              "my-account.plans.js",
              "scratch/**",
              "tweaks-panel.jsx",
              "ui_kits/webapp/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Karla|Gotu|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Karla, Gotu, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntentTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|kind|variant|style|key|ref|className|style|children)$/]",
        "message": "<IntentTag> doesn't accept that prop. Declared props: children, label, kind, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntentTag'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:intent|keyword)$/]",
        "message": "<IntentTag> kind must be one of 'intent' | 'keyword'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanFeatureItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|metaKind|dash|key|ref|className|style|children)$/]",
        "message": "<PlanFeatureItem> doesn't accept that prop. Declared props: label, meta, metaKind, dash."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, label, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "IntentTag": {
        "replaces": []
      },
      "PlanFeatureItem": {
        "replaces": []
      },
      "StatusBadge": {
