{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "name": "aisee dApp", "version": "1.0.0", "source": "aisee-dapp-design.v6.md" },
  "color": {
    "black": "#111111",
    "white": "#FFFFFF",
    "page": "#FAFAFA",
    "card": "#FFFFFF",
    "cardWarm": "#FBFBF3",
    "cream": "#F7F6E9",
    "analysis": { "primary": "#CFFF29", "hover": "#BFEE19", "soft": "rgba(207,255,41,0.18)", "pale": "#F5FFD4" },
    "postAgent": { "primary": "#FFE253", "hover": "#FCE055", "soft": "#FFF2B3", "pale": "#FFFADD" },
    "engage": { "banner": "#F3E7F4", "setup": "#F0FFBA", "lavender": "#FAE2FE", "gold": "#8C7400", "blue": "#4398FF" },
    "orange": "#EC5212",
    "danger": "#EC5212",
    "green": "#A5D500",
    "greenDark": "#92BC01",
    "redLight": "#FFD0D0",
    "gray200": "#E1E1E1",
    "gray300": "#D9D9D9",
    "textMuted": "rgba(17,17,17,0.60)",
    "textFaint": "rgba(17,17,17,0.40)",
    "border": "rgba(17,17,17,0.05)",
    "borderHover": "rgba(17,17,17,0.18)",
    "overlay": "rgba(17,17,17,0.40)"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "radius": { "control": "8px", "input": "8px", "card": "12px", "large": "16px", "modal": "16px", "pill": "9999px" },
  "shadow": {
    "card": "0 1px 3px rgba(0,0,0,0.06)",
    "dropdown": "0 10px 15px -3px rgba(0,0,0,0.10), 0 4px 6px -4px rgba(0,0,0,0.10)",
    "modal": "0 8px 8px rgba(0,0,0,0.04), 0 20px 24px rgba(0,0,0,0.10)",
    "confirmation": "0 20px 12px rgba(0,0,0,0.10), 0 8px 4px rgba(0,0,0,0.04)",
    "toast": "0 20px 24px -4px rgba(16,24,40,0.10), 0 8px 8px -4px rgba(16,24,40,0.04)"
  },
  "size": { "header": "70px", "sidebar": "224px", "input": "36px", "inputRing": "2px", "toggleWidth": "24px", "toggleHeight": "16px" },
  "font": {
    "family": { "ui": "Karla, sans-serif", "mono": "Karla, sans-serif", "gauge": "Karla, sans-serif" },
    "size": { "micro": "10px", "caption": "12px", "label": "13px", "body": "14px", "cardTitle": "16px", "section": "18px", "title": "20px", "stat": "32px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "micro": "120ms",
    "fast": "150ms",
    "normal": "250ms",
    "slow": "300ms"
  }
}
