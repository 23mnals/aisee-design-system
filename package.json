{
  "name": "@aisee/design-system",
  "version": "1.0.0",
  "private": true,
  "description": "aisee dApp design tokens, React components and usage guidance.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/GETTING_STARTED.md"
  ],
  "main": "./dist/aisee-design-system.cjs",
  "module": "./dist/aisee-design-system.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aisee-design-system.js",
      "require": "./dist/aisee-design-system.cjs"
    },
    "./styles.css": "./dist/design-system.css",
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/aisee-design-system.js",
      "require": "./dist/aisee-design-system.cjs"
    },
    "./tokens.json": "./dist/tokens.json",
    "./color-architecture.json": "./dist/color-architecture.json"
  },
  "scripts": {
    "sync:stemui": "node scripts/sync-stemui-assets.mjs",
    "dev": "npm run build:component-demos && node scripts/sync-legacy-browser-source.mjs && vite",
    "preview:local": "node scripts/serve-preview.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:component-demos": "node scripts/build-component-demos.mjs && npm run build:ai-deliveries",
    "build": "npm run tokens && npm run build:component-demos && node scripts/sync-legacy-browser-source.mjs && tsc -p tsconfig.build.json && vite build && node scripts/copy-package-assets.mjs",
    "site": "npm run build:component-demos && node scripts/build-static-site.mjs",
    "check": "npm run tokens:check && npm run typecheck && npm test && npm run build",
    "audit:copy-ai": "node scripts/audit-copy-ai.mjs",
    "pack:local": "npm run build && node scripts/pack-local.mjs",
    "verify:package": "node scripts/verify-local-package.mjs",
    "build:ai-deliveries": "node scripts/build-ai-deliveries.mjs",
    "verify:ai-deliveries": "npm run build:ai-deliveries && node scripts/verify-ai-deliveries.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.1",
    "postcss-value-parser": "4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "rolldown": "1.2.4",
    "typescript": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/23mnals/aisee-design-system.git"
  }
}
