{
  "name": "@aisee/design-system",
  "version": "1.0.0",
  "private": true,
  "description": "aisee dApp design tokens, React components and usage guidance.",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/aisee-design-system.cjs",
  "module": "./dist/aisee-design-system.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aisee-design-system.js",
      "require": "./dist/aisee-design-system.cjs"
    },
    "./styles.css": "./dist/design-system.css",
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/aisee-design-system.js",
      "require": "./dist/aisee-design-system.cjs"
    },
    "./tokens.json": "./dist/tokens.json",
    "./color-architecture.json": "./dist/color-architecture.json"
  },
  "scripts": {
    "sync:stemui": "node scripts/sync-stemui-assets.mjs",
    "dev": "node scripts/sync-legacy-browser-source.mjs && vite",
    "preview:local": "node scripts/serve-preview.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run tokens && node scripts/sync-legacy-browser-source.mjs && tsc -p tsconfig.build.json && vite build && node scripts/copy-package-assets.mjs",
    "site": "node scripts/build-static-site.mjs",
    "check": "npm run tokens:check && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "engines": { "node": ">=20" },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/23mnals/aisee-design-system.git"
  }
}
